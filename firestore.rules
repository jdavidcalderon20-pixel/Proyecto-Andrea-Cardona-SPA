rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Fallback
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // RBAC Security Rules
    // Only users with 'admin' role can read or modify the 'usuarios' collection
    match /usuarios/{userId} {
      allow read, write: if get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'admin';
      
      // Specifically allow users to read their OWN document even if they are not admin
      allow read: if request.auth.uid == userId;
    }

  }
}
